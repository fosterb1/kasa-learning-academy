# Copy to .env.local. Never commit real secrets.
DATABASE_URL=postgresql://kasa:kasa_local_only@localhost:5432/kasa_academy
PAYLOAD_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only used by the local, explicit bootstrap command:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-unique-admin-password-at-least-16-characters
SEED_CONTENT=no

# Optional admin-only AI caption generation. Set privately in Vercel, never NEXT_PUBLIC_.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=

# Full Netlify Kasa Playground origin, HTTPS only. When unset, /playground uses the local JS interpreter.
# NEXT_PUBLIC_KASA_PLAYGROUND_URL=https://your-kasa-site.netlify.app/
