{
  "name": "kasa-learning-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, CMS-powered Kasa programming education",
  "engines": {
    "node": "^24.22.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --test tests/academy-studio.test.mjs tests/studio-fa-firi-release.test.mjs tests/phase9-academy-alignment.test.mjs && payload generate:importmap && next build",
    "start": "next start",
    "generate:types": "payload generate:types",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "generate:importmap": "payload generate:importmap",
    "bootstrap:admin": "node --env-file=.env.local --import tsx scripts/bootstrap-admin.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test:smoke": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "next": "16.4.2",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
